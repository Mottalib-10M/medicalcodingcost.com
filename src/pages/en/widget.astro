---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
import { t } from '../../i18n/ui';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/coding-cost-comparator/" title="Medical coding credential cost comparator" width="100%" height="760" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the free medical coding credential cost comparator" description="Put the free medical coding credential cost comparator on a school, workforce or employer site: one iframe, CPC, CCA, CCS and more, no sign-up, no tracking, no cost." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the cost comparator</h1>
    <p class="mt-3 text-lg text-navy-700">For community colleges, workforce boards, career advisers and employers who sponsor coding credentials.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>Two credentials side by side</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Conditions: keep the credit line under the frame visible and use the comparator as it is, without warranty. When a fee changes, the frame follows. What visitors type stays in their browser, and the frame sets no cookie. It states that the site is independent of AAPC and AHIMA. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/coding-cost-comparator/" title="Medical coding credential cost comparator" width="100%" height="760" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
